<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_RescueJobLifecycle" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BA AI Agent" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_RescueJobLifecycle">
    <bpmn:participant id="Participant_RMS" name="RMS (Rescue Management System)" processRef="Process_RMS" />
    <bpmn:participant id="Participant_TMS" name="TMS (Accountant - Payment Confirmation)" processRef="Process_TMS" />
    <bpmn:messageFlow id="MessageFlow_RequestPayment" name="Request payment confirmation" sourceRef="Event_ThrowRequestPayment" targetRef="Event_MsgStartPaymentRequest" />
    <bpmn:messageFlow id="MessageFlow_PaymentConfirmed" name="Payment confirmed" sourceRef="Event_MsgEndPaymentConfirmed" targetRef="Event_CatchPaymentConfirmed" />
  </bpmn:collaboration>
  <bpmn:process id="Process_RMS" name="Rescue Job Lifecycle (RMS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_RMS">
      <bpmn:lane id="Lane_Scheduler" name="System / Scheduler">
        <bpmn:flowNodeRef>StartEvent_PackedSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_ReadyPickSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_DeliveryFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuardCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoCreate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ForkMain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoCreateApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CatchPaymentConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateUpdateSO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ApprovedResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RescueSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SalesCantRescue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SysAdmin" name="System Admin">
        <bpmn:flowNodeRef>StartEvent_AdminConfig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfigMode</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSAgent" name="CS Agent">
        <bpmn:flowNodeRef>Task_OpenUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectOption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitApproval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TeamLeader" name="Team Leader">
        <bpmn:flowNodeRef>Task_ManualAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TLReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FinalRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QA" name="QA">
        <bpmn:flowNodeRef>Task_QAReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G6b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ThrowRequestPayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_PackedSLA" name="Packed Time + SLA reached">
      <bpmn:outgoing>Flow_PackedSLA_ToGuard</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_ReadyPickSLA" name="Ready to Pick Time + SLA reached (CO)">
      <bpmn:outgoing>Flow_ReadyPickSLA_ToGuard</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_DeliveryFailed" name="DO Status = Delivery Failed">
      <bpmn:outgoing>Flow_DeliveryFailed_ToGuard</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GuardCheck" name="Check duplicate &amp; DO-status guard (no existing Rescue Job; DO not Delivered/Returned/Canceled)">
      <bpmn:incoming>Flow_PackedSLA_ToGuard</bpmn:incoming>
      <bpmn:incoming>Flow_ReadyPickSLA_ToGuard</bpmn:incoming>
      <bpmn:incoming>Flow_DeliveryFailed_ToGuard</bpmn:incoming>
      <bpmn:outgoing>Flow_Guard_ToAutoCreate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AutoCreate" name="Auto-create Rescue Job + log creation-trigger history">
      <bpmn:incoming>Flow_Guard_ToAutoCreate</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoCreate_ToFork</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ForkMain" name="Case processing and delivery-outcome monitoring proceed independently">
      <bpmn:incoming>Flow_AutoCreate_ToFork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_ToG2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_ToG7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_G2" name="Distribution Mode?" default="Flow_G2_Auto">
      <bpmn:incoming>Flow_Fork_ToG2</bpmn:incoming>
      <bpmn:incoming>Flow_ConfigMode_ToG2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_Auto</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AutoAssign" name="Auto-assign one job to CS Agent (priority-ranked) when agent opens My Rescue">
      <bpmn:incoming>Flow_G2_Auto</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoAssign_ToOpen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AutoCreateApproval" name="Auto-create Approval Rescue request">
      <bpmn:incoming>Flow_G4_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoCreateApproval_ToAction</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_CatchPaymentConfirmed" name="Payment confirmed (from TMS)">
      <bpmn:incoming>Flow_Throw_ToCatch</bpmn:incoming>
      <bpmn:outgoing>Flow_Catch_ToCreateSO</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Catch" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CreateUpdateSO" name="Create/Update SO (Option A: new SO / Option B: update existing SO)">
      <bpmn:incoming>Flow_G6b_No</bpmn:incoming>
      <bpmn:incoming>Flow_Catch_ToCreateSO</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateSO_ToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ApprovedResolved" name="Approved / Resolved">
      <bpmn:incoming>Flow_CreateSO_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_G7" name="DO final delivery outcome?" default="Flow_G7_Delivered">
      <bpmn:incoming>Flow_Fork_ToG7</bpmn:incoming>
      <bpmn:outgoing>Flow_G7_Delivered</bpmn:outgoing>
      <bpmn:outgoing>Flow_G7_Returned</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_RescueSuccess" name="Rescue Success">
      <bpmn:incoming>Flow_G7_Delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_SalesCantRescue" name="Sales Can't Rescue">
      <bpmn:incoming>Flow_G7_Returned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_AdminConfig" name="Admin sets/changes Distribution Mode">
      <bpmn:outgoing>Flow_AdminStart_ToConfigMode</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ConfigMode" name="Configure Distribution Mode (Manual/Auto)">
      <bpmn:incoming>Flow_AdminStart_ToConfigMode</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfigMode_ToG2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OpenUpdate" name="Open Rescue Job and update CS Status/Sub-status per customer contact outcome">
      <bpmn:incoming>Flow_AutoAssign_ToOpen</bpmn:incoming>
      <bpmn:incoming>Flow_ManualAssign_ToOpen</bpmn:incoming>
      <bpmn:incoming>Flow_G3_Uncontactable</bpmn:incoming>
      <bpmn:incoming>Flow_G3_Unreachable</bpmn:incoming>
      <bpmn:incoming>Flow_G3_NeedConvincing</bpmn:incoming>
      <bpmn:incoming>Flow_G3_WrongStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_Open_ToG3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G3" name="Contact outcome / sub-status?" default="Flow_G3_RequestApproval">
      <bpmn:incoming>Flow_Open_ToG3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_Uncontactable</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_Unreachable</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_NeedConvincing</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_WrongStatus</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_CustomerRefused</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_RequestApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Refused" name="Sales Can't Rescue (Refused)">
      <bpmn:incoming>Flow_G3_CustomerRefused</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_SelectOption" name="Select rescue option(s): Discount and/or Change to Bank Transfer; choose SO handling (Create New SO / Update Existing SO); save &amp; submit">
      <bpmn:incoming>Flow_G3_RequestApproval</bpmn:incoming>
      <bpmn:incoming>Flow_G4_No</bpmn:incoming>
      <bpmn:incoming>Flow_Resubmit_ToSelect</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_ToG4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G4" name="Validation passes? (discount &lt;=10% cumulative, max 2/Lead, blocked if SO already Bank Transfer)" default="Flow_G4_Yes">
      <bpmn:incoming>Flow_Select_ToG4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ApprovalAction" name="CS action on pending Approval Rescue?" default="Flow_Action_Proceed">
      <bpmn:incoming>Flow_AutoCreateApproval_ToAction</bpmn:incoming>
      <bpmn:outgoing>Flow_Action_Proceed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Cancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Resubmit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CancelApproval" name="Cancel pending approval (only while Processing)">
      <bpmn:incoming>Flow_Action_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel_ToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Cancelled" name="Cancelled">
      <bpmn:incoming>Flow_Cancel_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ResubmitApproval" name="Resubmit for Approval (only if none Processing and none approved-with-new-SO)">
      <bpmn:incoming>Flow_Action_Resubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_Resubmit_ToSelect</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ManualAssign" name="Manually assign Rescue Job to CS Agent">
      <bpmn:incoming>Flow_G2_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualAssign_ToOpen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TLReview" name="Review Approval Rescue (own team only)">
      <bpmn:incoming>Flow_Action_Proceed</bpmn:incoming>
      <bpmn:outgoing>Flow_TLReview_ToG5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G5" name="Team Leader decision?" default="Flow_G5_Approve">
      <bpmn:incoming>Flow_TLReview_ToG5</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_Approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_FinalRejected" name="Final Rejected">
      <bpmn:incoming>Flow_G5_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_G6_Reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_QAReview" name="Final review of Approval Rescue">
      <bpmn:incoming>Flow_G5_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_QAReview_ToG6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G6" name="QA decision?" default="Flow_G6_Approve">
      <bpmn:incoming>Flow_QAReview_ToG6</bpmn:incoming>
      <bpmn:outgoing>Flow_G6_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_G6_Approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_G6b" name="Payment method = Bank Transfer?" default="Flow_G6b_No">
      <bpmn:incoming>Flow_G6_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_G6b_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_G6b_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_ThrowRequestPayment" name="Send payment confirmation request">
      <bpmn:incoming>Flow_G6b_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Throw_ToCatch</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Throw" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_PackedSLA_ToGuard" sourceRef="StartEvent_PackedSLA" targetRef="Task_GuardCheck" />
    <bpmn:sequenceFlow id="Flow_ReadyPickSLA_ToGuard" sourceRef="StartEvent_ReadyPickSLA" targetRef="Task_GuardCheck" />
    <bpmn:sequenceFlow id="Flow_DeliveryFailed_ToGuard" sourceRef="StartEvent_DeliveryFailed" targetRef="Task_GuardCheck" />
    <bpmn:sequenceFlow id="Flow_Guard_ToAutoCreate" sourceRef="Task_GuardCheck" targetRef="Task_AutoCreate" />
    <bpmn:sequenceFlow id="Flow_AutoCreate_ToFork" sourceRef="Task_AutoCreate" targetRef="Gateway_ForkMain" />
    <bpmn:sequenceFlow id="Flow_Fork_ToG2" sourceRef="Gateway_ForkMain" targetRef="Gateway_G2" />
    <bpmn:sequenceFlow id="Flow_Fork_ToG7" sourceRef="Gateway_ForkMain" targetRef="Gateway_G7" />
    <bpmn:sequenceFlow id="Flow_AdminStart_ToConfigMode" sourceRef="StartEvent_AdminConfig" targetRef="Task_ConfigMode" />
    <bpmn:sequenceFlow id="Flow_ConfigMode_ToG2" name="Mode configured (no stated default)" sourceRef="Task_ConfigMode" targetRef="Gateway_G2" />
    <bpmn:sequenceFlow id="Flow_G2_Auto" name="Auto" sourceRef="Gateway_G2" targetRef="Task_AutoAssign" />
    <bpmn:sequenceFlow id="Flow_G2_Manual" name="Manual" sourceRef="Gateway_G2" targetRef="Task_ManualAssign" />
    <bpmn:sequenceFlow id="Flow_AutoAssign_ToOpen" sourceRef="Task_AutoAssign" targetRef="Task_OpenUpdate" />
    <bpmn:sequenceFlow id="Flow_ManualAssign_ToOpen" sourceRef="Task_ManualAssign" targetRef="Task_OpenUpdate" />
    <bpmn:sequenceFlow id="Flow_Open_ToG3" sourceRef="Task_OpenUpdate" targetRef="Gateway_G3" />
    <bpmn:sequenceFlow id="Flow_G3_Uncontactable" name="Uncontactable" sourceRef="Gateway_G3" targetRef="Task_OpenUpdate" />
    <bpmn:sequenceFlow id="Flow_G3_Unreachable" name="Unreachable" sourceRef="Gateway_G3" targetRef="Task_OpenUpdate" />
    <bpmn:sequenceFlow id="Flow_G3_NeedConvincing" name="Need More Convincing" sourceRef="Gateway_G3" targetRef="Task_OpenUpdate" />
    <bpmn:sequenceFlow id="Flow_G3_WrongStatus" name="Wrong Status / Resend to 3PL" sourceRef="Gateway_G3" targetRef="Task_OpenUpdate" />
    <bpmn:sequenceFlow id="Flow_G3_CustomerRefused" name="Customer Refused" sourceRef="Gateway_G3" targetRef="EndEvent_Refused" />
    <bpmn:sequenceFlow id="Flow_G3_RequestApproval" name="Request for Approval" sourceRef="Gateway_G3" targetRef="Task_SelectOption" />
    <bpmn:sequenceFlow id="Flow_Select_ToG4" sourceRef="Task_SelectOption" targetRef="Gateway_G4" />
    <bpmn:sequenceFlow id="Flow_G4_No" name="No (validation fails)" sourceRef="Gateway_G4" targetRef="Task_SelectOption" />
    <bpmn:sequenceFlow id="Flow_G4_Yes" name="Yes" sourceRef="Gateway_G4" targetRef="Task_AutoCreateApproval" />
    <bpmn:sequenceFlow id="Flow_AutoCreateApproval_ToAction" sourceRef="Task_AutoCreateApproval" targetRef="Gateway_ApprovalAction" />
    <bpmn:sequenceFlow id="Flow_Action_Proceed" name="Proceed to review" sourceRef="Gateway_ApprovalAction" targetRef="Task_TLReview" />
    <bpmn:sequenceFlow id="Flow_Action_Cancel" name="Cancel (while Processing)" sourceRef="Gateway_ApprovalAction" targetRef="Task_CancelApproval" />
    <bpmn:sequenceFlow id="Flow_Action_Resubmit" name="Resubmit (none Processing &amp; none approved-with-new-SO)" sourceRef="Gateway_ApprovalAction" targetRef="Task_ResubmitApproval" />
    <bpmn:sequenceFlow id="Flow_Cancel_ToEnd" sourceRef="Task_CancelApproval" targetRef="EndEvent_Cancelled" />
    <bpmn:sequenceFlow id="Flow_Resubmit_ToSelect" sourceRef="Task_ResubmitApproval" targetRef="Task_SelectOption" />
    <bpmn:sequenceFlow id="Flow_TLReview_ToG5" sourceRef="Task_TLReview" targetRef="Gateway_G5" />
    <bpmn:sequenceFlow id="Flow_G5_Reject" name="Reject (with comment)" sourceRef="Gateway_G5" targetRef="EndEvent_FinalRejected" />
    <bpmn:sequenceFlow id="Flow_G5_Approve" name="Approve" sourceRef="Gateway_G5" targetRef="Task_QAReview" />
    <bpmn:sequenceFlow id="Flow_QAReview_ToG6" sourceRef="Task_QAReview" targetRef="Gateway_G6" />
    <bpmn:sequenceFlow id="Flow_G6_Reject" name="Reject (with comment)" sourceRef="Gateway_G6" targetRef="EndEvent_FinalRejected" />
    <bpmn:sequenceFlow id="Flow_G6_Approve" name="Approve" sourceRef="Gateway_G6" targetRef="Gateway_G6b" />
    <bpmn:sequenceFlow id="Flow_G6b_No" name="No (not Bank Transfer)" sourceRef="Gateway_G6b" targetRef="Task_CreateUpdateSO" />
    <bpmn:sequenceFlow id="Flow_G6b_Yes" name="Yes (Bank Transfer)" sourceRef="Gateway_G6b" targetRef="Event_ThrowRequestPayment" />
    <bpmn:sequenceFlow id="Flow_Throw_ToCatch" sourceRef="Event_ThrowRequestPayment" targetRef="Event_CatchPaymentConfirmed" />
    <bpmn:sequenceFlow id="Flow_Catch_ToCreateSO" sourceRef="Event_CatchPaymentConfirmed" targetRef="Task_CreateUpdateSO" />
    <bpmn:sequenceFlow id="Flow_CreateSO_ToEnd" sourceRef="Task_CreateUpdateSO" targetRef="EndEvent_ApprovedResolved" />
    <bpmn:sequenceFlow id="Flow_G7_Delivered" name="Delivered" sourceRef="Gateway_G7" targetRef="EndEvent_RescueSuccess" />
    <bpmn:sequenceFlow id="Flow_G7_Returned" name="Returned / Canceled" sourceRef="Gateway_G7" targetRef="EndEvent_SalesCantRescue" />
  </bpmn:process>
  <bpmn:process id="Process_TMS" name="Payment Confirmation (TMS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TMS">
      <bpmn:lane id="Lane_Accountant" name="Accountant">
        <bpmn:flowNodeRef>Event_MsgStartPaymentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_MsgEndPaymentConfirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_MsgStartPaymentRequest" name="Payment confirmation requested">
      <bpmn:outgoing>Flow_TMS_StartToConfirm</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_TMSStart" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ConfirmPayment" name="Confirm payment in TMS">
      <bpmn:incoming>Flow_TMS_StartToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_TMS_ConfirmToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_MsgEndPaymentConfirmed" name="Payment confirmation sent">
      <bpmn:incoming>Flow_TMS_ConfirmToEnd</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_TMSEnd" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TMS_StartToConfirm" sourceRef="Event_MsgStartPaymentRequest" targetRef="Task_ConfirmPayment" />
    <bpmn:sequenceFlow id="Flow_TMS_ConfirmToEnd" sourceRef="Task_ConfirmPayment" targetRef="Event_MsgEndPaymentConfirmed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_RescueJobLifecycle">
      <bpmndi:BPMNShape id="Participant_RMS_di" bpmnElement="Participant_RMS" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="4320" height="1100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Scheduler_di" bpmnElement="Lane_Scheduler" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="4290" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SysAdmin_di" bpmnElement="Lane_SysAdmin" isHorizontal="true">
        <dc:Bounds x="30" y="300" width="4290" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CSAgent_di" bpmnElement="Lane_CSAgent" isHorizontal="true">
        <dc:Bounds x="30" y="420" width="4290" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TeamLeader_di" bpmnElement="Lane_TeamLeader" isHorizontal="true">
        <dc:Bounds x="30" y="820" width="4290" height="140" />
      </bpmndi:BPMNShape>
